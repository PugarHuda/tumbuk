# Tumbuk config (all optional — the tool works with zero config for local/offline use)

# Ops (optional):
# TUMBUK_ACCESS_KEY=       # if set, redteam_scan requires a matching access_key

# x402 / X Layer native paid endpoint (OKX A2MCP) — set TUMBUK_X402_PAYTO to enable.
# CONFIRMED OKX values (same facilitator/asset validated live by the sibling DALANG
# project) are already the code defaults in x402.py — you only need to set PAYTO.
# TUMBUK_X402_PAYTO=<your X Layer wallet>                        # recipient — enables the gate
# TUMBUK_X402_FACILITATOR=https://web3.okx.com/facilitator       # OKX facilitator (default)
# TUMBUK_X402_NETWORK=eip155:196                                 # X Layer mainnet (default)
# TUMBUK_X402_ASSET=0x779ded0c9e1022225f8e0630b35a9b54be713736   # USDT0 on X Layer (default)
# TUMBUK_X402_ASSET_NAME=USD₮0                                   # EIP-712 domain name (default)
# TUMBUK_X402_ASSET_VERSION=1                                    # EIP-712 domain version (default)
# TUMBUK_X402_AMOUNT=990000                                      # price in atomic units ($0.99, 6dp)
# TUMBUK_X402_TIMEOUT=300                                        # auth window (s)

# OKX Developer Portal credentials — REQUIRED for a paid listing to pass review.
# The facilitator answers 403 to unsigned calls, so without these nothing can be
# verified or settled. Get them at https://web3.okx.com/onchainos/dev-portal
# (the passphrase is the one you chose when creating the key).
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
